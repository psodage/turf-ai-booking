# ============================================================
# Turf AI Booking — Environment Variables Reference
# ============================================================

# Server
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/turfai_dev
DATABASE_USERNAME=turfai
DATABASE_PASSWORD=turfai

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# AI Provider
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000

# Payment Gateway (Razorpay Payment Links)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Reports
REPORT_STORAGE_PATH=/tmp/turfai-reports
REPORT_RETENTION_DAYS=7

# Scheduling Crons
HOLD_CLEANUP_CRON=0 */2 * * * *
REMINDER_CRON=0 0 * * * *
DAILY_REPORT_CRON=0 0 22 * * *

# Logging
LOG_LEVEL=INFO