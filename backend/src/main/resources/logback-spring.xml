<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console Appender for Local Development / Test Profiles -->
    <springProfile name="dev, test, default">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{correlationId}] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
        <logger name="com.turfai.booking" level="DEBUG" />
    </springProfile>

    <!-- Structured JSON Appender for Staging & Production Profiles -->
    <springProfile name="staging, prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <message>message</message>
                    <logger>logger</logger>
                    <level>level</level>
                    <thread>thread</thread>
                </fieldNames>
                <includeMdcKeyName>correlationId</includeMdcKeyName>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="JSON_CONSOLE" />
        </root>
        <logger name="com.turfai.booking" level="INFO" />
    </springProfile>

</configuration>
